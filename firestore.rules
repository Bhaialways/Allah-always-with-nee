rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Domain validation helpers
    function isValidUserChallengeProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.niyyahTitle is string && data.niyyahTitle.size() >= 1 && data.niyyahTitle.size() <= 100 &&
             data.challengeStartMillis is int && data.challengeStartMillis > 0 &&
             data.targetDays is int && data.targetDays >= 1 && data.targetDays <= 3650 &&
             data.longestStreakDays is int && data.longestStreakDays >= 0 && data.longestStreakDays <= 36500 &&
             data.urgesOvercomeCount is int && data.urgesOvercomeCount >= 0 && data.urgesOvercomeCount <= 1000000 &&
             data.totalResetsCount is int && data.totalResetsCount >= 0 && data.totalResetsCount <= 1000000 &&
             data.completedEpisodes is list && data.completedEpisodes.size() <= 11 &&
             (data.completedEpisodes.size() == 0 || (data.completedEpisodes[0] is int && data.completedEpisodes[0] >= 1 && data.completedEpisodes[0] <= 11)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUrgeLogEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.outcome is string && data.outcome in ['OVERCOME', 'SLIP'] &&
             data.triggerNote is string && data.triggerNote.size() <= 300 &&
             data.intensity is int && data.intensity >= 1 && data.intensity <= 5 &&
             data.dhikrCount is int && data.dhikrCount >= 0 && data.dhikrCount <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidEpisodeReflection(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.episodeNumber is int && data.episodeNumber >= 1 && data.episodeNumber <= 11 &&
             data.reflection is string && data.reflection.size() <= 500 &&
             data.completed is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // User profile & challenge state
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'niyyahTitle', 'challengeStartMillis',
                         'targetDays', 'longestStreakDays', 'urgesOvercomeCount',
                         'totalResetsCount', 'completedEpisodes', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'niyyahTitle', 'challengeStartMillis',
                         'targetDays', 'longestStreakDays', 'urgesOvercomeCount',
                         'totalResetsCount', 'completedEpisodes', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserChallengeProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserChallengeProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Update challenge start date/time, niyyah title, target days, or display name
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'niyyahTitle', 'challengeStartMillis', 'targetDays', 'updatedAt'
                         ]) ||
                         // Action 2: Record urge victory or slip/reset
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'challengeStartMillis', 'longestStreakDays', 'urgesOvercomeCount', 'totalResetsCount', 'updatedAt'
                         ]) ||
                         // Action 3: Update completed episode list
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'completedEpisodes', 'updatedAt'
                         ])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection: urgeLogs
      match /urgeLogs/{logId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(logId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'outcome', 'triggerNote', 'intensity', 'dhikrCount', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'outcome', 'triggerNote', 'intensity', 'dhikrCount', 'createdAt'
                         ]) &&
                         isValidUrgeLogEntry(incoming());

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // Subcollection: episodeNotes
      match /episodeNotes/{episodeId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(episodeId) && episodeId.matches('^ep_([1-9]|1[01])$');

        allow create: if isOwner(userId) &&
                         isValidId(episodeId) &&
                         episodeId.matches('^ep_([1-9]|1[01])$') &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'episodeNumber', 'reflection', 'completed', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'episodeNumber', 'reflection', 'completed', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidEpisodeReflection(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(episodeId) &&
                         episodeId.matches('^ep_([1-9]|1[01])$') &&
                         isValidEpisodeReflection(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().episodeNumber == existing().episodeNumber &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'reflection', 'completed', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(episodeId);
      }
    }
  }
}
